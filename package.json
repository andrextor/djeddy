{
  "name": "djeddy",
  "private": true,
  "version": "0.0.1",
  "description": "Landing page for DJ Eddy",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro check && astro build",
    "build:release": "RELEASE=1 astro check && RELEASE=1 astro build",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/lib/*.test.ts\"",
    "check:content": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/list-placeholders.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "astro check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "astro": "^7.2.10",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
