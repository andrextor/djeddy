---
import logo from '@/assets/dj-eddy-logo-dark.png'
import Contact from '@/components/Contact.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Hero from '@/components/Hero.astro'
import Services from '@/components/Services.astro'
import Videos from '@/components/Videos.astro'
import WhatsAppButton from '@/components/WhatsAppButton.astro'
import { site } from '@/data/site'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { buildJsonLd, serializeJsonLd } from '@/lib/seo'

const title = `${site.name} · DJ en ${site.city} para fiestas, marcas y empresas`
const ogImageUrl = new URL('/og.jpg', Astro.site).href
const logoUrl = new URL(logo.src, Astro.site).href
const jsonLd = serializeJsonLd(buildJsonLd(site, ogImageUrl, logoUrl))
const instagram = site.socials.find((social) => social.network === 'instagram')
---

<BaseLayout title={title} description={site.tagline}>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd} />
  <Header />
  <main id="main">
    <Hero />
    <Videos videos={site.videos} moreClipsUrl={instagram?.url ?? site.socials[0].url} />
    <Services />
    <Contact />
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
