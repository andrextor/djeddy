---
import type { FaqItem } from '@/data/site'
import Icon from './Icon.astro'
import type { Props as HeadingProps } from './SectionHeading.astro'
import SectionHeading from './SectionHeading.astro'

export interface Props {
  faq: readonly FaqItem[]
  index: HeadingProps['index']
}

const { faq, index } = Astro.props
---

{
  faq.length > 0 && (
    <section id="preguntas" class="faq" aria-labelledby="faq-title">
      <SectionHeading
        index={index}
        label="Preguntas"
        title="Antes de reservar"
        id="faq-title"
      />
      <div class="list">
        {faq.map((item) => (
          <details name="faq">
            <summary>
              <h3>{item.question}</h3>
              <Icon name="plus" size={20} class="toggle" />
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 64px var(--gutter) 0;
    scroll-margin-top: 90px;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  details {
    border-radius: var(--radius-inner);
    border: 1px solid var(--border-subtle);
    background: var(--color-surface-row);
  }
  details[open] {
    border-color: var(--border-default);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--tap-min);
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    border-radius: var(--radius-inner);
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  h3 {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-text);
  }
  .toggle {
    flex: 0 0 auto;
    color: var(--color-accent);
    transition: transform 0.25s ease;
  }
  details[open] .toggle {
    transform: rotate(45deg);
  }
  p {
    padding: 0 18px 18px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (min-width: 1024px) {
    .faq {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
      gap: 64px;
      padding: 0 var(--gutter) var(--section-gap);
      scroll-margin-top: 120px;
    }
    summary {
      padding: 20px 24px;
    }
    h3 {
      font-size: 18px;
    }
    p {
      padding: 0 24px 22px;
      font-size: 16px;
    }
  }
</style>
