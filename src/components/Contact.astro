---
import { site } from '@/data/site'
import { buildQuoteMessage, buildWhatsAppUrl } from '@/lib/whatsapp'
import QuoteButton from './QuoteButton.astro'
import type { Props as HeadingProps } from './SectionHeading.astro'
import SectionHeading from './SectionHeading.astro'

export interface Props {
  index: HeadingProps['index']
}

const { index } = Astro.props

const whatsappUrl = buildWhatsAppUrl(site.whatsapp.number, buildQuoteMessage())
const instagram = site.socials.find((social) => social.network === 'instagram')
---

<section id="contacto" class="contact" aria-labelledby="contact-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="panel glass">
    <SectionHeading index={index} label="Contacto" title="Reserva tu fecha." id="contact-title" />
    <p class="lead">Te respondo el mismo día.</p>
    <QuoteButton />
    <ul class="links">
      <li><a href={whatsappUrl} target="_blank" rel="noopener">{site.whatsapp.display}</a></li>
      <li><a href={`mailto:${site.email}`}>Correo</a></li>
      {
        instagram && (
          <li>
            <a href={instagram.url} target="_blank" rel="noopener">
              Instagram
            </a>
          </li>
        )
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding: 64px var(--gutter) 0;
    scroll-margin-top: 90px;
  }
  .glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--glow-accent), transparent 65%);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 18px;
    padding: 32px 22px 22px;
    border-radius: 28px;
    text-align: center;
  }
  .panel :global(.heading),
  .panel :global(.eyebrow) {
    justify-content: center;
  }
  .panel :global(h2) {
    font-size: 44px;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .lead {
    font-size: 16px;
    color: var(--color-text-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
  }
  .links a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 1024px) {
    .contact {
      padding: 0 var(--gutter) var(--section-gap);
      scroll-margin-top: 120px;
    }
    .glow {
      top: 40%;
      width: 900px;
      height: 500px;
    }
    .panel {
      align-items: center;
      gap: 24px;
      padding: 72px;
      border-radius: 36px;
    }
    .panel :global(h2) {
      font-size: 72px;
    }
    .panel :global(.quote-button) {
      align-self: center;
      height: 60px;
      padding: 0 36px;
      box-shadow: var(--shadow-cta);
    }
    .lead {
      font-size: 18px;
    }
    .links a {
      font-size: 15px;
    }
  }
</style>
