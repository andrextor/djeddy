---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { site } from '@/data/site'
import { buildQuoteMessage, buildWhatsAppUrl } from '@/lib/whatsapp'
import Icon from './Icon.astro'
import SectionHeading from './SectionHeading.astro'

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order)
---

<section id="eventos" class="services" aria-labelledby="services-title">
  <SectionHeading
    index="01"
    label="Eventos"
    title={`Bodas, fiestas y empresas en ${site.city}`}
    id="services-title"
    lead="Un set distinto para cada tipo de evento."
  />

  <ul class="list focus-group">
    {
      services.map((service, index) => {
        const href =
          service.data.url ?? buildWhatsAppUrl(site.whatsapp.number, buildQuoteMessage(service.data.title))
        return (
          <li>
            <a class:list={['card', { alt: index % 2 === 1 }]} href={href} target="_blank" rel="noopener">
              <div class="media">
                {service.data.image ? (
                  <Image
                    src={service.data.image}
                    alt=""
                    widths={[420, 840]}
                    sizes="(min-width: 1024px) 420px, 96px"
                    loading="lazy"
                  />
                ) : (
                  <div class="grain" />
                )}
                <span class="tag">{service.data.tag}</span>
              </div>
              <div class="body">
                <h3>{service.data.title}</h3>
                <p class="meta">{service.data.description}</p>
                <span class="quote">
                  Cotizar <Icon name="arrow-up-right" size={16} />
                </span>
              </div>
            </a>
          </li>
        )
      })
    }
  </ul>
</section>

<style>
  .services {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 64px var(--gutter) 0;
    scroll-margin-top: 90px;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 16px;
    padding: 14px;
    border-radius: 20px;
    border: 1px solid var(--border-default);
    background: var(--gradient-row);
    color: var(--color-text);
  }
  .card.alt {
    background: var(--gradient-row-alt);
  }
  .media {
    position: relative;
    flex: 0 0 96px;
    border-radius: var(--radius-inner);
    overflow: hidden;
    background: var(--gradient-event-a);
  }
  .alt .media {
    background: var(--gradient-event-b);
  }
  .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tag {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 4px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .body {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    min-height: 96px;
  }
  h3 {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-text);
  }
  .meta {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .quote {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-accent);
  }
  .card:hover .quote {
    color: var(--color-accent-light);
  }

  @media (min-width: 1024px) {
    .services {
      gap: 48px;
      padding: var(--section-gap) var(--gutter);
      scroll-margin-top: 120px;
    }
    .list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
    .card {
      flex-direction: column;
      justify-content: flex-end;
      height: 500px;
      padding: 24px;
      border-radius: var(--radius-card);
      overflow: hidden;
      background: var(--gradient-event-a);
    }
    .card.alt {
      background: var(--gradient-event-b);
    }
    .media {
      position: absolute;
      inset: 0;
      flex: none;
      border-radius: 0;
      background: transparent;
    }
    .media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--scrim-card);
    }
    .tag {
      left: 24px;
      top: 24px;
      bottom: auto;
      z-index: 1;
      padding: 10px 14px;
      font-size: 12px;
      letter-spacing: 0.16em;
    }
    .body {
      position: relative;
      z-index: 1;
      flex: none;
      gap: 10px;
      min-height: 0;
    }
    h3 {
      font-size: 22px;
      line-height: 1.15;
      letter-spacing: -0.02em;
    }
    .meta {
      font-size: 15px;
    }
    .quote {
      font-size: 14px;
    }
  }
</style>
