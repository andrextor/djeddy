---
import { Image } from 'astro:assets'
import type { Video } from '@/data/site'
import Icon from './Icon.astro'
import SectionHeading from './SectionHeading.astro'

export interface Props {
  videos: readonly Video[]
  moreClipsUrl: string
}

const { videos, moreClipsUrl } = Astro.props
const embedUrl = (id: string): string => `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`
const thumbnailUrl = (id: string): string => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`
const facadeData = (video: Video): Record<string, string> =>
  video.kind === 'youtube'
    ? { 'data-embed': embedUrl(video.youtubeId) }
    : { 'data-video': video.src }
---

<section id="videos" class="videos" aria-labelledby="videos-title">
  <div class="head">
    <SectionHeading
      index="01"
      label="Videos"
      title="En acción"
      id="videos-title"
      lead="Lo que se siente cuando el set arranca."
    />
    <span class="swipe" aria-hidden="true">Desliza →</span>
  </div>

  <div class="layout">
    {
      videos.map((video, index) => (
        <article class="card video">
          <button class="facade" type="button" {...facadeData(video)} aria-label={`Reproducir: ${video.title}`}>
            {video.kind === 'youtube' ? (
              <img src={thumbnailUrl(video.youtubeId)} alt="" loading="lazy" width="480" height="360" />
            ) : (
              <Image src={video.poster} alt="" widths={[300, 600]} sizes="(min-width: 1024px) 300px, 240px" loading="lazy" />
            )}
            <span class="play glass"><Icon name="play" size={28} class="gold" /></span>
          </button>
          <div class="caption glass">
            <div>
              <span class="label">Video {index + 1}</span>
              <h3>{video.title}</h3>
            </div>
            {video.duration && <span class="duration">{video.duration}</span>}
          </div>
        </article>
      ))
    }

    <a class="more" href={moreClipsUrl} target="_blank" rel="noopener">
      <Icon name="arrow-up-right" size={28} />
      <div>
        <span class="more-title">Más clips</span>
        <span class="more-sub">Instagram · TikTok · YouTube</span>
      </div>
    </a>
  </div>
</section>

<script is:inline>
  // Facade: the YouTube player (~1 MB of third-party JS) or the MP4 loads only when a viewer asks for it.
  for (const facade of document.querySelectorAll('.facade')) {
    facade.addEventListener('click', () => {
      let player
      if (facade.dataset.embed) {
        player = document.createElement('iframe')
        player.src = facade.dataset.embed
        player.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture'
        player.allowFullscreen = true
      } else {
        player = document.createElement('video')
        player.src = facade.dataset.video
        player.controls = true
        player.autoplay = true
        player.playsInline = true
      }
      player.title = facade.getAttribute('aria-label')
      // Copy Astro's scoped-style attribute so the card CSS applies to the injected player.
      for (const { name } of facade.attributes) {
        if (name.startsWith('data-astro-cid')) player.setAttribute(name, '')
      }
      facade.closest('.card')?.classList.add('playing')
      facade.replaceWith(player)
    })
  }
  // Only one video plays at a time.
  document.addEventListener(
    'play',
    (event) => {
      for (const other of document.querySelectorAll('video')) {
        if (other !== event.target) other.pause()
      }
    },
    true,
  )
</script>

<style>
  .videos {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 64px 0 0;
    scroll-margin-top: 90px;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 var(--gutter);
  }
  .swipe {
    padding-bottom: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .layout {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 var(--gutter) 8px;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .layout::-webkit-scrollbar {
    display: none;
  }
  .layout > * {
    flex: 0 0 240px;
    aspect-ratio: 9 / 16;
    scroll-snap-align: start;
  }
  .video {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--border-default);
    background: var(--gradient-card);
  }
  .video:nth-child(even) {
    background: var(--gradient-card-alt);
  }
  .facade,
  iframe,
  video {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Landscape posters crop to 9:16; the performer sits right of centre in them. */
    object-position: 70% center;
    opacity: 0.6;
  }
  video {
    object-fit: contain;
    background: var(--color-media-bg);
  }
  .card.playing,
  .card.playing:hover {
    transform: none;
    filter: none;
  }
  .card.playing .caption {
    display: none;
  }
  .facade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim-video);
  }
  .facade .play {
    z-index: 1;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition:
      transform 0.35s ease,
      background 0.35s ease;
  }
  .gold {
    color: var(--color-accent);
  }
  .facade:hover .play {
    background: color-mix(in srgb, var(--color-accent) 90%, transparent);
    transform: translate(-50%, -50%) scale(1.12);
  }
  .facade:hover .gold {
    color: var(--color-on-accent);
  }
  .caption {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 12px;
    border-radius: var(--radius-inner);
    pointer-events: none;
  }
  .caption > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  h3 {
    font-size: 15px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .duration {
    flex: 0 0 auto;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .more {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    border-radius: var(--radius-card);
    background: var(--gradient-gold);
    color: var(--color-on-accent);
  }
  .more:hover {
    color: var(--color-on-accent);
    filter: brightness(1.06);
  }
  .more > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .more-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .more-sub {
    font-size: 13px;
    font-weight: 600;
    opacity: 0.75;
  }

  @media (min-width: 1024px) {
    .videos {
      gap: 48px;
      padding: var(--section-gap) var(--gutter);
      scroll-margin-top: 120px;
    }
    .head {
      padding: 0;
    }
    .swipe {
      display: none;
    }
    .layout {
      gap: 24px;
      padding: 0 0 8px;
    }
    .layout > * {
      flex-basis: 300px;
    }
    .play {
      width: 80px;
      height: 80px;
    }
    h3 {
      font-size: 17px;
    }
    .more-sub {
      font-size: 14px;
    }
  }
</style>
