---
import type { Video } from '@/data/site'
import Icon from './Icon.astro'
import SectionHeading from './SectionHeading.astro'

export interface Props {
  videos: readonly [Video, Video]
  moreClipsUrl: string
}

const { videos, moreClipsUrl } = Astro.props
const [first, second] = videos
const embedUrl = (id: string): string => `https://www.youtube-nocookie.com/embed/${id}`
---

<section id="videos" class="videos" aria-labelledby="videos-title">
  <div class="head">
    <SectionHeading
      index="01"
      label="Videos"
      title="En acción"
      id="videos-title"
      lead="Lo que se siente cuando el set arranca."
    />
    <span class="swipe" aria-hidden="true">Desliza →</span>
  </div>

  <div class="layout">
    <article class="card video main">
      <iframe
        src={embedUrl(first.youtubeId)}
        title={first.title}
        loading="lazy"
        allow="accelerometer; encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>
      <div class="caption glass">
        <div>
          <span class="label">Video 1</span>
          <h3>{first.title}</h3>
        </div>
        {first.duration && <span class="duration">{first.duration}</span>}
      </div>
    </article>

    <article class="card video secondary">
      <iframe
        src={embedUrl(second.youtubeId)}
        title={second.title}
        loading="lazy"
        allow="accelerometer; encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>
      <div class="caption glass">
        <div>
          <span class="label">Video 2</span>
          <h3>{second.title}</h3>
        </div>
        {second.duration && <span class="duration">{second.duration}</span>}
      </div>
    </article>

    <a class="more" href={moreClipsUrl} target="_blank" rel="noopener">
      <Icon name="arrow-up-right" size={28} />
      <div>
        <span class="more-title">Más clips</span>
        <span class="more-sub">Instagram · TikTok · YouTube</span>
      </div>
    </a>
  </div>
</section>

<style>
  .videos {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 64px 0 0;
    scroll-margin-top: 90px;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 var(--gutter);
  }
  .swipe {
    padding-bottom: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .layout {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 var(--gutter) 8px;
    scrollbar-width: none;
  }
  .layout::-webkit-scrollbar {
    display: none;
  }
  .layout > * {
    flex: 0 0 300px;
    scroll-snap-align: start;
  }
  .video {
    position: relative;
    height: 380px;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--border-gold-22);
    background: var(--gradient-card);
  }
  .secondary {
    background: var(--gradient-card-alt);
  }
  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .caption {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--radius-inner);
    pointer-events: none;
  }
  .caption > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  h3 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .duration {
    display: none;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .more {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 380px;
    padding: 22px;
    border-radius: var(--radius-card);
    background: var(--gradient-gold);
    color: var(--color-bg);
  }
  .more:hover {
    color: var(--color-bg);
    filter: brightness(1.06);
  }
  .more > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .more-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .more-sub {
    font-size: 13px;
    font-weight: 600;
    opacity: 0.75;
  }

  @media (min-width: 1024px) {
    .videos {
      gap: 48px;
      padding: var(--section-gap) var(--gutter);
      scroll-margin-top: 120px;
    }
    .head {
      padding: 0;
    }
    .swipe {
      display: none;
    }
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
      grid-template-rows: 1fr 128px;
      gap: 24px;
      overflow: visible;
      padding: 0;
    }
    .layout > * {
      flex: none;
    }
    .main {
      grid-row: 1 / 3;
      height: 620px;
    }
    .secondary {
      height: auto;
    }
    .caption {
      left: 24px;
      right: 24px;
      bottom: 24px;
      padding: 18px 24px;
    }
    .label {
      font-size: 11px;
      letter-spacing: 0.2em;
    }
    .main h3 {
      font-size: 22px;
    }
    .secondary h3 {
      font-size: 20px;
    }
    .duration {
      display: inline;
    }
    .more {
      flex-direction: row-reverse;
      align-items: center;
      height: 128px;
      padding: 0 32px;
    }
    .more-sub {
      font-size: 14px;
    }
  }
</style>
