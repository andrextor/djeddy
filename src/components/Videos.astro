---
import { Image } from 'astro:assets'
import type { Video } from '@/data/site'
import Icon from './Icon.astro'
import SectionHeading from './SectionHeading.astro'

export interface Props {
  videos: readonly [Video, Video]
  moreClipsUrl: string
}

const { videos, moreClipsUrl } = Astro.props
const [first, second] = videos
const embedUrl = (id: string): string => `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`
const thumbnailUrl = (id: string): string => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`
const facadeData = (video: Video): Record<string, string> =>
  video.kind === 'youtube'
    ? { 'data-embed': embedUrl(video.youtubeId) }
    : { 'data-video': video.src }
---

<section id="videos" class="videos" aria-labelledby="videos-title">
  <div class="head">
    <SectionHeading
      index="01"
      label="Videos"
      title="En acción"
      id="videos-title"
      lead="Lo que se siente cuando el set arranca."
    />
    <span class="swipe" aria-hidden="true">Desliza →</span>
  </div>

  <div class="layout">
    <article class="card video main">
      <button
        class="facade"
        type="button"
        {...facadeData(first)}
        aria-label={`Reproducir: ${first.title}`}
      >
        {first.kind === 'youtube' ? (
          <img src={thumbnailUrl(first.youtubeId)} alt="" loading="lazy" width="480" height="360" />
        ) : (
          <Image src={first.poster} alt="" widths={[540, 1080]} sizes="(min-width: 1024px) 480px, 300px" loading="lazy" />
        )}
        <span class="play glass"><Icon name="play" size={34} class="gold" /></span>
      </button>
      <div class="caption glass">
        <div>
          <span class="label">Video 1</span>
          <h3>{first.title}</h3>
        </div>
        {first.duration && <span class="duration">{first.duration}</span>}
      </div>
    </article>

    <article class="card video secondary">
      <button
        class="facade"
        type="button"
        {...facadeData(second)}
        aria-label={`Reproducir: ${second.title}`}
      >
        {second.kind === 'youtube' ? (
          <img src={thumbnailUrl(second.youtubeId)} alt="" loading="lazy" width="480" height="360" />
        ) : (
          <Image src={second.poster} alt="" widths={[540, 1080]} sizes="(min-width: 1024px) 480px, 300px" loading="lazy" />
        )}
        <span class="play glass"><Icon name="play" size={26} class="gold" /></span>
      </button>
      <div class="caption glass">
        <div>
          <span class="label">Video 2</span>
          <h3>{second.title}</h3>
        </div>
        {second.duration && <span class="duration">{second.duration}</span>}
      </div>
    </article>

    <a class="more" href={moreClipsUrl} target="_blank" rel="noopener">
      <Icon name="arrow-up-right" size={28} />
      <div>
        <span class="more-title">Más clips</span>
        <span class="more-sub">Instagram · TikTok · YouTube</span>
      </div>
    </a>
  </div>
</section>

<script is:inline>
  // Facade: the YouTube player (~1 MB of third-party JS) or the MP4 loads only when a viewer asks for it.
  for (const facade of document.querySelectorAll('.facade')) {
    facade.addEventListener('click', () => {
      let player
      if (facade.dataset.embed) {
        player = document.createElement('iframe')
        player.src = facade.dataset.embed
        player.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture'
        player.allowFullscreen = true
      } else {
        player = document.createElement('video')
        player.src = facade.dataset.video
        player.controls = true
        player.autoplay = true
        player.playsInline = true
      }
      player.title = facade.getAttribute('aria-label')
      // Copy Astro's scoped-style attribute so the card CSS applies to the injected player.
      for (const { name } of facade.attributes) {
        if (name.startsWith('data-astro-cid')) player.setAttribute(name, '')
      }
      facade.closest('.card')?.classList.add('playing')
      facade.replaceWith(player)
    })
  }
  // Only one video plays at a time.
  document.addEventListener(
    'play',
    (event) => {
      for (const other of document.querySelectorAll('video')) {
        if (other !== event.target) other.pause()
      }
    },
    true,
  )
</script>

<style>
  .videos {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 64px 0 0;
    scroll-margin-top: 90px;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 var(--gutter);
  }
  .swipe {
    padding-bottom: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .layout {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 var(--gutter) 8px;
    scrollbar-width: none;
  }
  .layout::-webkit-scrollbar {
    display: none;
  }
  .layout > * {
    flex: 0 0 300px;
    scroll-snap-align: start;
  }
  .video {
    position: relative;
    height: 380px;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--border-gold-22);
    background: var(--gradient-card);
  }
  .secondary {
    background: var(--gradient-card-alt);
  }
  .facade,
  iframe,
  video {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }
  video {
    object-fit: contain;
    background: #000;
  }
  .card.playing,
  .card.playing:hover {
    transform: none;
    filter: none;
  }
  .card.playing .caption {
    display: none;
  }
  .facade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 6, 4, 0.25) 0%, rgba(7, 6, 4, 0.75) 100%);
  }
  .facade .play {
    z-index: 1;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition:
      transform 0.35s ease,
      background 0.35s ease;
  }
  .gold {
    color: var(--color-gold);
  }
  .facade:hover .play {
    background: rgba(212, 175, 55, 0.9);
    transform: translate(-50%, -50%) scale(1.12);
  }
  .facade:hover .gold {
    color: var(--color-bg);
  }
  .caption {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--radius-inner);
    pointer-events: none;
  }
  .caption > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  h3 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .duration {
    display: none;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .more {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 380px;
    padding: 22px;
    border-radius: var(--radius-card);
    background: var(--gradient-gold);
    color: var(--color-bg);
  }
  .more:hover {
    color: var(--color-bg);
    filter: brightness(1.06);
  }
  .more > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .more-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .more-sub {
    font-size: 13px;
    font-weight: 600;
    opacity: 0.75;
  }

  @media (min-width: 1024px) {
    .videos {
      gap: 48px;
      padding: var(--section-gap) var(--gutter);
      scroll-margin-top: 120px;
    }
    .head {
      padding: 0;
    }
    .swipe {
      display: none;
    }
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
      grid-template-rows: 1fr 128px;
      gap: 24px;
      overflow: visible;
      padding: 0;
    }
    .layout > * {
      flex: none;
    }
    .main {
      grid-row: 1 / 3;
      height: 620px;
    }
    .secondary {
      height: auto;
    }
    .caption {
      left: 24px;
      right: 24px;
      bottom: 24px;
      padding: 18px 24px;
    }
    .label {
      font-size: 11px;
      letter-spacing: 0.2em;
    }
    .main h3 {
      font-size: 22px;
    }
    .secondary h3 {
      font-size: 20px;
    }
    .duration {
      display: inline;
    }
    .main .play {
      width: 104px;
      height: 104px;
    }
    .secondary .play {
      width: 80px;
      height: 80px;
    }
    .more {
      flex-direction: row-reverse;
      align-items: center;
      height: 128px;
      padding: 0 32px;
    }
    .more-sub {
      font-size: 14px;
    }
  }
</style>
