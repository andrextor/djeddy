---
import type { SiteConfig } from '@/data/site'
import Icon from './Icon.astro'
import QuoteButton from './QuoteButton.astro'
import SectionHeading from './SectionHeading.astro'

export interface Props {
  included: SiteConfig['included']
}

const { included } = Astro.props
const steps = ['Escríbeme', 'Propuesta el mismo día', 'A bailar'] as const
---

<section id="como-trabajo" class="process" aria-labelledby="process-title">
  <SectionHeading index="03" label="Cómo trabajo" title="Tú celebras, yo me encargo" id="process-title" />
  <p class="line">Llevo todo y leo la pista para que nadie se quede sentado.</p>

  <ul class="tiles" aria-label="Qué incluye">
    {
      included.map((item) => (
        <li class="glass">
          <Icon name={item.icon} size={26} class="icon" />
          <span>{item.label}</span>
        </li>
      ))
    }
  </ul>

  <ol class="steps" aria-label="Cómo reservar">
    {
      steps.map((step, index) => (
        <li>
          <span class="number">{String(index + 1).padStart(2, '0')}</span>
          <span class="step">{step}</span>
        </li>
      ))
    }
  </ol>

  <QuoteButton />
</section>

<style>
  .process {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 64px var(--gutter) 0;
    scroll-margin-top: 90px;
  }
  .line {
    margin-top: -8px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .tiles li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 16px;
    border-radius: var(--radius-inner);
    border: 1px solid var(--border-default);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
  }
  .icon {
    color: var(--color-accent);
  }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .steps li {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .number {
    min-width: 2.2ch;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent-dark);
  }
  .step {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text);
  }

  @media (min-width: 1024px) {
    .process {
      gap: 32px;
      padding: 0 var(--gutter) var(--section-gap);
      scroll-margin-top: 120px;
    }
    .line {
      font-size: 17px;
    }
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
    .tiles li {
      padding: 28px;
      font-size: 18px;
    }
    .steps {
      flex-direction: row;
      align-items: center;
      gap: 0;
    }
    .steps li {
      flex: 1 1 0;
    }
    .steps li + li::before {
      content: '→';
      margin-right: 24px;
      font-size: 22px;
      color: var(--color-accent);
    }
    .step {
      font-size: 20px;
    }
  }
</style>
