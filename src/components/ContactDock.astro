---
import { site } from '@/data/site'
import { buildQuoteMessage, buildWhatsAppUrl } from '@/lib/whatsapp'
import Icon from './Icon.astro'

const whatsappUrl = buildWhatsAppUrl(site.whatsapp.number, buildQuoteMessage())
---

<nav class="dock glass" aria-label="Conecta">
  <span class="label" aria-hidden="true">Conecta</span>
  {
    site.socials.map((social) => (
      <a class="link" href={social.url} target="_blank" rel="noopener" aria-label={`Sígueme en ${social.label}`}>
        <Icon name={social.network} size={22} />
      </a>
    ))
  }
  <a class="link whatsapp" href={whatsappUrl} target="_blank" rel="noopener" aria-label="Escríbeme por WhatsApp">
    <Icon name="whatsapp" size={24} />
    <span class="whatsapp-text" aria-hidden="true">WhatsApp</span>
  </a>
</nav>

<style>
  .dock {
    position: fixed;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 12px;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2px;
    padding: 4px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-float);
  }
  .label {
    display: none;
  }
  .link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: var(--tap-min);
    height: var(--tap-min);
    border-radius: var(--radius-pill);
    color: var(--color-text);
  }
  .link:hover {
    color: var(--color-accent);
  }
  .whatsapp,
  .whatsapp:hover {
    padding: 0 16px;
    background: var(--color-whatsapp);
    color: var(--color-on-whatsapp);
    font-size: 14px;
    font-weight: 700;
  }

  @media (min-width: 1024px) {
    .dock {
      left: auto;
      right: 0;
      top: 50%;
      bottom: auto;
      flex-direction: column;
      gap: 8px;
      padding: 20px 8px;
      border-right: 0;
      border-radius: var(--radius-card) 0 0 var(--radius-card);
      transform: translateY(-50%);
    }
    .label {
      display: block;
      margin-bottom: 4px;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .whatsapp {
      padding: 0;
      background: transparent;
      color: var(--color-whatsapp);
    }
    .whatsapp:hover {
      background: transparent;
      color: var(--color-accent-light);
    }
    .whatsapp-text {
      display: none;
    }
  }
</style>
